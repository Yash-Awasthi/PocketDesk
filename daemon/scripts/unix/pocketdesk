#!/usr/bin/env bash
# PocketDesk control CLI for macOS and Linux.
# The daemon has no window; this is how you start, stop, and pair it where there is no Task Manager.
#   pocketdesk start | stop | restart | status | pair | logs
set -euo pipefail

HOME_DIR="${POCKETDESK_HOME:-$HOME/.pocketdesk}"
CONFIG="$HOME_DIR/config.json"
LOG="$HOME_DIR/daemon.log"
PIDFILE="$HOME_DIR/daemon.pid"

# The install copies the daemon here; a checkout runs from its own tree.
DAEMON_DIR="${POCKETDESK_DAEMON_DIR:-$HOME_DIR/daemon}"
[ -f "$DAEMON_DIR/src/index.js" ] || DAEMON_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

json_field() { node -e "try{process.stdout.write(String(JSON.parse(require('fs').readFileSync('$CONFIG','utf8')).$1||''))}catch(e){}" 2>/dev/null; }
port() { local p; p=$(json_field port); echo "${p:-8765}"; }
scheme() { node -e "try{process.stdout.write(JSON.parse(require('fs').readFileSync('$CONFIG','utf8')).tls&&JSON.parse(require('fs').readFileSync('$CONFIG','utf8')).tls.enabled?'https':'http')}catch(e){process.stdout.write('http')}" 2>/dev/null; }

running_pid() {
  # The listener on the daemon port is the daemon, whichever shell started it.
  if command -v lsof >/dev/null 2>&1; then lsof -ti ":$(port)" -sTCP:LISTEN 2>/dev/null | head -1; fi
}

start() {
  if [ -n "$(running_pid)" ]; then echo "already running (port $(port))"; return 0; fi
  [ -f "$DAEMON_DIR/src/index.js" ] || { echo "daemon not found at $DAEMON_DIR" >&2; exit 1; }
  mkdir -p "$HOME_DIR"
  # Detached and headless: it keeps running after this shell exits, logging to the home dir.
  ( cd "$DAEMON_DIR" && RH_STOP_ON_STDIN_EOF=0 nohup node src/index.js >>"$LOG" 2>&1 & echo $! >"$PIDFILE" )
  sleep 1
  [ -n "$(running_pid)" ] && echo "started (port $(port))" || { echo "failed to start; see $LOG" >&2; exit 1; }
}

stop() {
  local pid; pid="$(running_pid)"
  if [ -z "$pid" ]; then echo "not running"; rm -f "$PIDFILE"; return 0; fi
  kill "$pid" 2>/dev/null || true
  for _ in 1 2 3 4 5; do [ -n "$(running_pid)" ] || break; sleep 1; done
  [ -n "$(running_pid)" ] && kill -9 "$(running_pid)" 2>/dev/null || true
  rm -f "$PIDFILE"
  echo "stopped"
}

status() {
  local pid; pid="$(running_pid)"
  if [ -n "$pid" ]; then echo "running (pid $pid, port $(port))"; else echo "stopped"; fi
}

pair() {
  local url="$(scheme)://localhost:$(port)/pair?k=$(json_field token)"
  echo "$url"
  if command -v open >/dev/null 2>&1; then open "$url" 2>/dev/null || true
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" 2>/dev/null || true; fi
}

case "${1:-status}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  status ;;
  pair)    pair ;;
  logs)    tail -n "${2:-50}" "$LOG" 2>/dev/null || echo "no log yet" ;;
  *) echo "usage: pocketdesk {start|stop|restart|status|pair|logs}" >&2; exit 1 ;;
esac
