<?xml version="1.0" encoding="UTF-8"?>
<!-- Starts the PocketDesk menu-bar tray at login; the tray starts the hidden daemon.
     __TRAY__ is replaced with the installed binary path by install.sh. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pocketdesk.tray</string>
  <key>ProgramArguments</key>
  <array><string>__TRAY__</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
</dict>
</plist>
