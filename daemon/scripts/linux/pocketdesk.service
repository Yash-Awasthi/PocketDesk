# PocketDesk daemon as a systemd user service, hidden like the Windows build (it shows in the
# system monitor; `pocketdesk stop` or `systemctl --user stop pocketdesk` stops it). __NODE__, __DAEMON__
# and __PATH__ are replaced by install.sh.
[Unit]
Description=PocketDesk daemon
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__DAEMON__
Environment=RH_STOP_ON_STDIN_EOF=0
Environment="PATH=__PATH__"
ExecStart=__NODE__ src/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
