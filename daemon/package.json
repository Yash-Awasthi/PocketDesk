{
  "name": "pocketdesk-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pocketdesk": "src/index.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/index.js",
    "setup-tls": "node scripts/gen-cert.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "test": "node --test --test-global-setup=test/setup.mjs \"test/*.test.mjs\"",
    "coverage": "c8 --reporter=json-summary --reporter=text-summary node --test --test-global-setup=test/setup.mjs \"test/*.test.mjs\" && node scripts/check-coverage.mjs",
    "coverage:areas": "node scripts/coverage-areas.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "optionalDependencies": {
    "@number0/iroh": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
