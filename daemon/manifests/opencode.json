{
  "id": "opencode",
  "name": "OpenCode",
  "adapter": "terminal",
  "bin": "opencode",
  "install": { "npm": "opencode-ai" },
  "chat": {
    "args": [],
    "format": "text",
    "resumeArgs": ["--continue"],
    "models": {
      "claude-sonnet-4-5": { "args": ["--model", "claude-sonnet-4-5"] },
      "claude-opus-4-1": { "args": ["--model", "claude-opus-4-1"] },
      "gemini-3-pro": { "args": ["--model", "gemini-3-pro"] }
    }
  }
}
