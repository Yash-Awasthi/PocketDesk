{
  "id": "codex",
  "name": "Codex CLI",
  "adapter": "terminal",
  "bin": "codex",
  "install": { "npm": "@openai/codex" },
  "chat": {
    "args": ["exec", "--json", "-"],
    "format": "codex-json",
    "resumeArgs": ["exec", "resume", "--last", "--json", "-"],
    "models": {
      "gpt-5-codex": { "args": ["--model", "gpt-5-codex"] },
      "gpt-5.1-codex": { "args": ["--model", "gpt-5.1-codex"] },
      "gpt-5.2-codex": { "args": ["--model", "gpt-5.2-codex"] }
    }
  }
}
