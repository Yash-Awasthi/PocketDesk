{
  "id": "claude",
  "name": "Claude Code",
  "adapter": "terminal",
  "bin": "claude",
  "install": { "npm": "@anthropic-ai/claude-code" },
  "auth": { "status": ["auth", "status"], "login": ["auth", "login"], "logout": ["auth", "logout"] },
  "chat": {
    "args": ["-p", "--output-format", "stream-json", "--verbose"],
    "modelArg": ["--model"],
    "format": "claude-stream-json",
    "resumeArgs": ["--continue", "-p", "--output-format", "stream-json", "--verbose"],
    "resumeIdArgs": ["-p", "--output-format", "stream-json", "--verbose", "--resume", "{id}"],
    "models": {
      "opus": { "args": ["--model", "opus"] },
      "sonnet": { "args": ["--model", "sonnet"] },
      "haiku": { "args": ["--model", "haiku"] }
    }
  }
}
